spec: "1.0"
id: "com.grooveforge.harmonizer"
name: "Harmonizer"
version: "1.1.0"
type: midi_fx

# ─── Parameters ────────────────────────────────────────────────────────────
# Parameters are listed in paramId order, which is the order a saved `.gf`
# project stores them in. interval1/interval2/snap_to_scale keep the ids
# they shipped with in 1.0.0 so older projects still load with the same
# harmony; voice_count and the two extra voices are appended after them.
#
# Voice count: integer 1..4 — how many of the intervals below are played.
#              Defaults to 2, which is exactly what version 1.0.0 did.
# Intervals:   0..24 semitones above the played note. 0 means unison, which
#              the node skips (a duplicate of the note itself adds nothing).
parameters:
  - id: interval1
    paramId: 0
    name: "Harmony 1"
    min: 0
    max: 24
    default: 4
    unit: "st"
    display: interval
  - id: interval2
    paramId: 1
    name: "Harmony 2"
    min: 0
    max: 24
    default: 7
    unit: "st"
    display: interval
  - id: snap_to_scale
    paramId: 2
    name: "Scale Lock"
    min: 0
    max: 1
    default: 1
    type: toggle

  - id: voice_count
    paramId: 3
    name: "Voices"
    min: 1
    max: 4
    default: 2
    unit: ""
    display: integer
  - id: interval3
    paramId: 4
    name: "Harmony 3"
    min: 0
    max: 24
    default: 12
    unit: "st"
    display: interval
  - id: interval4
    paramId: 5
    name: "Harmony 4"
    min: 0
    max: 24
    default: 16
    unit: "st"
    display: interval

midi_nodes:
  - id: harm
    type: harmonize
    params:
      voiceCount:  { param: voice_count }
      interval1:   { param: interval1 }
      interval2:   { param: interval2 }
      interval3:   { param: interval3 }
      interval4:   { param: interval4 }
      snapToScale: { param: snap_to_scale }

# One lane per voice, matching the Audio Harmonizer. Lanes past the voice
# count grey out, so a three-voice setting no longer shows four live rows.
ui:
  layout: lanes
  groups:
    - label: "Setup"
      controls:
        - type: selector
          param: voice_count
          label: "Voices"
        - type: toggle
          param: snap_to_scale
          label: "Scale Lock"
          size: small

    - label: "V1"
      activeWhen: { param: voice_count, atLeast: 1 }
      controls:
        - type: interval
          param: interval1

    - label: "V2"
      activeWhen: { param: voice_count, atLeast: 2 }
      controls:
        - type: interval
          param: interval2

    - label: "V3"
      activeWhen: { param: voice_count, atLeast: 3 }
      controls:
        - type: interval
          param: interval3

    - label: "V4"
      activeWhen: { param: voice_count, atLeast: 4 }
      controls:
        - type: interval
          param: interval4
